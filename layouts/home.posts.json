{{- /* For "Visa fler" (main.js): every case and post, newest first, then the work history
       (Bakgrund) in its front-matter order, the same order as the home listings. Each item
       is its type and its HTML, rendered by the same partials as the home page. */ -}}
{{- $items := slice -}}
{{- $w := 0 -}}
{{- range (where site.RegularPages "Section" "in" (slice "work" "blog")).ByDate.Reverse -}}
  {{- if eq .Section "work" -}}
    {{- $items = $items | append (dict "type" "work" "html" (partial "work-card.html" (dict "page" . "i" $w))) -}}
    {{- $w = add $w 1 -}}
  {{- else -}}
    {{- $items = $items | append (dict "type" "blog" "html" (partial "blog-item.html" .)) -}}
  {{- end -}}
{{- end -}}
{{- range site.Home.Params.background.items -}}
  {{- $items = $items | append (dict "type" "background" "html" (partial "background-item.html" .)) -}}
{{- end -}}
{{- $items | jsonify (dict "indent" "  ") -}}
